# Large model / tokenizer artifacts
/models/*
!/models/README.md
*.bin
*.i16
*.q8
*.q4
*.safetensors
*.gguf
*.tok

# KV / quant experiment artifacts
*.kv
*.npz
*.tokens
*.npy

# Logs and runtime files
*.log
*.pid
*.tmp
core
core.*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Engine/build outputs
/engine/engine
/engine/engine_mm3
/engine/engine_mm3_pi

# Probe binaries are build outputs; track the sources only.  A hand-written
# list of probe names is how probes/packunpack_probe got committed (5 times):
# every sibling was listed, that one was not.  Negate on the sources instead.
/engine/probes/*
!/engine/probes/*.cpp
!/engine/probes/*.h
!/engine/probes/README*

# Editor / OS
.DS_Store
*.swp
*~

# Local upstream references / model assets
/refs/
/minimind3/tokenizer.json

# Local agent overrides (machine-specific, not portable)
/AGENTS.local.md
/AGENTS.override.md

# Agent scratch (campaign scripts, audits)
.bench/
